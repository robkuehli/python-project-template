# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ---- Application -----------------------------------------------------------
# APP_ENV=development
# LOG_LEVEL=INFO
# DATABASE_URL=
# API_KEY=
{%- set wants_litellm = (
  ('claude_code' in coding_agents and claude_provider == 'litellm')
  or ('codex' in coding_agents and codex_provider == 'litellm')
  or ('aider' in coding_agents and aider_provider == 'litellm')
) %}
{%- set wants_ollama = (
  'opencode' in coding_agents
  or ('aider' in coding_agents and aider_provider == 'ollama')
) %}
{%- if wants_litellm %}

# ---- LiteLLM gateway -------------------------------------------------------
# Token for the company gateway ({{ litellm_base_url }}).
{%- if 'claude_code' in coding_agents and claude_provider == 'litellm' %}
# Claude Code reads this as ANTHROPIC_AUTH_TOKEN:
# ANTHROPIC_AUTH_TOKEN=
{%- endif %}
{%- set openai_key_users = [] %}
{%- if 'codex' in coding_agents and codex_provider == 'litellm' %}{% set _ = openai_key_users.append('Codex') %}{% endif %}
{%- if 'aider' in coding_agents and aider_provider == 'litellm' %}{% set _ = openai_key_users.append('Aider') %}{% endif %}
{%- if openai_key_users %}
# {{ openai_key_users | join(' / ') }} read this as OPENAI_API_KEY:
# OPENAI_API_KEY=
{%- endif %}
{%- endif %}
{%- if wants_ollama %}
{%- set ollama_tier_resolved = ollama_tier | default('local', true) %}
{%- set ollama_local_models = [] %}
{%- set ollama_uses_cloud = ('opencode' in coding_agents and ollama_subscription
                              and ollama_tier_resolved in ['cloud', 'hybrid']) %}
{%- if 'aider' in coding_agents and aider_provider == 'ollama' %}
{%-   set _ = ollama_local_models.append(aider_model | replace('ollama/', '')) %}
{%- endif %}
{%- if 'opencode' in coding_agents %}
{%-   if ollama_tier_resolved == 'local' %}
{%-     set _ = ollama_local_models.append('qwen3-coder:30b') %}
{%-     set _ = ollama_local_models.append('qwen3:4b') %}
{%-   elif ollama_tier_resolved == 'hybrid' %}
{%-     set _ = ollama_local_models.append('qwen3:4b') %}
{%-   endif %}
{%- endif %}

# ---- Ollama (local daemon, plus cloud proxy if signed in) ------------------
# The daemon at {{ ollama_base_url }} serves both local-pulled models AND
# `:cloud`-tagged models (when you've run `ollama signin`).
{%- if ollama_local_models %}
# Local models to pull:
{%- for model in ollama_local_models | unique %}
#   ollama pull {{ model }}
{%- endfor %}
{%- endif %}
{%- if ollama_uses_cloud %}
# Cloud auth (one-time):
#   ollama signin
# The chosen tier ({{ ollama_tier_resolved }}) uses these `:cloud` models:
{%- if ollama_tier_resolved == 'cloud' %}
#   glm-5.2:cloud, gpt-oss:20b-cloud  (default large + small_model)
#   kimi-k2.6:cloud, kimi-k2.7-code:cloud, deepseek-v4-pro:cloud  (extras for /model)
{%- else %}
#   glm-5.2:cloud  (default large; small_model stays local on qwen3:4b)
#   kimi-k2.6:cloud, deepseek-v4-pro:cloud  (extras for /model)
{%- endif %}
{%- endif %}
{%- endif %}
{%- if include_sandbox %}

# ---- Sandbox -------------------------------------------------------------
# Required: secret for the SearXNG instance. Sandbox won't start without it.
SEARXNG_SECRET=        # generate: openssl rand -hex 32

# Resource caps for the agent container (override host defaults).
# SANDBOX_CPUS=2.8
# SANDBOX_MEM=6g
{%- if include_crawl4ai %}

# ---- Crawl4AI (fetch sidecar) --------------------------------------------
# Bearer token for the local Crawl4AI service. Required to start the sidecar.
# CRAWL4AI_API_TOKEN=        # generate: openssl rand -hex 32
# CRAWL4AI_CPUS=1.5
# CRAWL4AI_MEM=2g
{%- endif %}
{%- if sandbox_observability == 'langfuse' %}

# ---- Langfuse v3 (observability) -----------------------------------------
# v3 needs a postgres + clickhouse + redis + minio backing stack; the compose
# file fails loudly on `:?` guards if ENCRYPTION_KEY or NEXTAUTH_SECRET are
# unset. Generate every secret once: openssl rand -hex 32
# LANGFUSE_ENCRYPTION_KEY=        # required
# LANGFUSE_NEXTAUTH_SECRET=       # required
# LANGFUSE_SALT=
# LANGFUSE_NEXTAUTH_URL=http://localhost:3000
#
# Backing services — defaults work in the sandbox; rotate before exposure.
# LANGFUSE_DB_PASSWORD=langfuse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_REDIS_AUTH=redis
# LANGFUSE_MINIO_ROOT_USER=minio
# LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
#
# Project keys — paste after first-boot UI setup, then restart the agent.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
{%- elif sandbox_observability == 'mlflow' %}

# ---- MLflow (observability) ----------------------------------------------
# No setup required — the tracking server runs at http://localhost:5000.
{%- endif %}
{%- endif %}
