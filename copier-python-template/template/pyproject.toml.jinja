[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
{%- if license == "Proprietary" %}
license = { text = "Proprietary" }
classifiers = [
    "Private :: Do Not Upload",
    "Programming Language :: Python :: {{ python_version }}",
]
{%- else %}
license = "{{ license }}"
classifiers = [
    "Programming Language :: Python :: {{ python_version }}",
]
{%- endif %}
dependencies = []

[project.urls]
Homepage = "https://github.com/{{ github_username }}/{{ project_slug }}"
Documentation = "https://{{ github_username }}.github.io/{{ project_slug }}/"
Repository = "https://github.com/{{ github_username }}/{{ project_slug }}"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

# --------------------------------------------------------------------------
# uv — dependency groups (installed with `uv sync`)
# --------------------------------------------------------------------------
[dependency-groups]
dev = [
    "pre-commit>=4.0",
    "ruff>=0.15",
    "mypy>=1.13",
    "pylint>=3.3",
    "bandit[toml]>=1.9",
    "pytest>=8.3",
    "pytest-sugar>=1.0",
    "pytest-cov>=6.0",
{%- if include_sql %}
    "sqlfluff>=3.2",
{%- endif %}
]
docs = [
    "mkdocs-material>=9.5",
    "mkdocstrings[python]>=0.27",
]

[tool.uv]
default-groups = ["dev", "docs"]

# --------------------------------------------------------------------------
# Ruff — linter + formatter
# --------------------------------------------------------------------------
[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"
src = ["src", "tests"]

[tool.ruff.lint]
select = [
    "E", "F", "W",  # pycodestyle + pyflakes
    "I",            # isort
    "N",            # pep8-naming
    "UP",           # pyupgrade
    "B",            # flake8-bugbear
    "C4",           # flake8-comprehensions
    "SIM",          # flake8-simplify
    "D",            # pydocstyle
]
ignore = ["D203", "D213"]  # mutually exclusive docstring rules

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"tests/*" = ["D", "S101"]  # no docstring/assert rules in tests

[tool.ruff.format]
docstring-code-format = true

# --------------------------------------------------------------------------
# mypy — static type checking (strict)
# --------------------------------------------------------------------------
[tool.mypy]
python_version = "{{ python_version }}"
strict = true
warn_unreachable = true
pretty = true
show_error_codes = true
files = ["src", "tests"]

# --------------------------------------------------------------------------
# Pylint — read via --rcfile=pyproject.toml in the hook
# --------------------------------------------------------------------------
[tool.pylint.main]
py-version = "{{ python_version }}"
jobs = 0
ignore-paths = ["^\\.venv/.*$", "^site/.*$"]

[tool.pylint.format]
max-line-length = 100

[tool.pylint.messages_control]
# Ruff already enforces these — disable here to avoid duplicate noise.
disable = [
    "missing-module-docstring",
    "missing-class-docstring",
    "missing-function-docstring",
]

# --------------------------------------------------------------------------
# Bandit — read via -c pyproject.toml in the hook
# --------------------------------------------------------------------------
[tool.bandit]
exclude_dirs = [".venv", "site", "tests"]

# --------------------------------------------------------------------------
# pytest
# --------------------------------------------------------------------------
[tool.pytest.ini_options]
minversion = "8.0"
addopts = "-ra --strict-markers --strict-config"
testpaths = ["tests"]

# --------------------------------------------------------------------------
# coverage
# --------------------------------------------------------------------------
[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true
{%- if include_sql %}

# --------------------------------------------------------------------------
# sqlfluff — read via --config pyproject.toml in the hook.
# A dialect is REQUIRED, otherwise sqlfluff errors out.
# --------------------------------------------------------------------------
[tool.sqlfluff.core]
dialect = "{{ sql_dialect }}"
max_line_length = 100
{%- endif %}
