# Task runner — run `just` (or `just --list`) to see all recipes.
# https://github.com/casey/just

set shell := ["bash", "-cu"]

# Show available recipes
default:
    @just --list

# Create the venv, install all deps and the git hooks
install:
    uv sync
    uv run pre-commit install

# Sync the environment from the lockfile
sync:
    uv sync

# Full quality gate (this is what CI runs)
qa: lint typecheck test

# Run all pre-commit hooks across the whole repo
lint:
    uv run pre-commit run --all-files

# Auto-format and auto-fix
format:
    uv run ruff format .
    uv run ruff check --fix .

# Static type checking
typecheck:
    uv run mypy .

# Run the test suite (e.g. `just test tests/test_smoke.py`)
test *args:
    uv run pytest {{ args }}

# Run tests with a coverage report
cov:
    uv run pytest --cov --cov-report=term-missing

# Serve the docs locally with live reload
docs:
    uv run mkdocs serve

# Build the static docs site (fails on warnings)
docs-build:
    uv run mkdocs build --strict

# Pull the latest changes from the Copier template into this project
update:
    uv run copier update --trust --skip-answered

# Remove caches and build artifacts
clean:
    rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov site dist build .coverage
    find . -type d -name __pycache__ -exec rm -rf {} +
