{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "autoCompactEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/statusline.sh"
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16384"
{%- if claude_provider == 'litellm' %},
    "ANTHROPIC_BASE_URL": {{ litellm_base_url | tojson }},
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
{%- endif %}
  },
  "permissions": {
{#- Build the allow/ask/deny arrays in-jinja, then dump them via `tojson` —
    avoids fragile trailing-comma logic when any of the source lists is
    empty or reordered. -#}
{%- set allow_items = ['Read', 'Glob', 'Grep', 'WebSearch', 'Edit', 'Write'] -%}
{%- for pattern in shared_allow_bash -%}
{%- set _ = allow_items.append('Bash(' ~ pattern ~ ')') -%}
{%- endfor -%}
{%- set ask_items = ['WebFetch'] -%}
{%- for pattern in shared_ask_bash -%}
{%- set _ = ask_items.append('Bash(' ~ pattern ~ ')') -%}
{%- endfor -%}
{%- set deny_items = [] -%}
{%- for pattern in shared_deny_read -%}
{%- set _ = deny_items.append('Read(' ~ pattern ~ ')') -%}
{%- endfor -%}
{%- for pattern in shared_deny_read if pattern.startswith('**/.env') -%}
{%- set _ = deny_items.append('Write(' ~ pattern ~ ')') -%}
{%- endfor -%}
{%- for pattern in shared_deny_write -%}
{%- set _ = deny_items.append('Write(' ~ pattern ~ ')') -%}
{%- set _ = deny_items.append('Edit(' ~ pattern ~ ')') -%}
{%- endfor -%}
{%- for pattern in shared_deny_bash -%}
{%- set _ = deny_items.append('Bash(' ~ pattern ~ ')') -%}
{%- endfor %}
    "allow": {{ allow_items | tojson }},
    "ask": {{ ask_items | tojson }},
    "deny": {{ deny_items | tojson }},
    "defaultMode": "default"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "F=$(jq -r '.tool_input.file_path // empty'); [[ \"$F\" == *.py ]] && command -v ruff >/dev/null 2>&1 && ruff format \"$F\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
{#- Fast-fail regex backstop for irreversible commands. This is defence in
    depth, NOT the authoritative list — the canonical deny set is
    `shared_deny_bash` in copier.yml (rendered into permissions.deny above).
    Keep the irreversible patterns here in sync with that list when editing
    either one (currently: recursive rm, sudo rm, chmod 777, curl|wget pipe to
    shell, DROP TABLE / TRUNCATE). -#}
          {
            "type": "command",
            "command": "CMD=$(jq -r '.tool_input.command // empty'); echo \"$CMD\" | grep -qiE 'rm[[:space:]]+(-[rfR-]+[[:space:]]*)+(/|\\$HOME|~)|sudo[[:space:]]+rm|chmod[[:space:]]+(-R[[:space:]]+)?777|(curl|wget)[[:space:]].*\\|[[:space:]]*(bash|sh|sudo)|drop[[:space:]]+table|truncate[[:space:]]+(table[[:space:]])?' && { echo \"Blocked: dangerous command pattern\" >&2; exit 2; }; exit 0"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/filter-pytest-output.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh"
          }
        ]
      }
    ]
  },
{#- Plugins are MCP servers / command bundles loaded into the agent's tool
    surface. Each one is supply chain (OWASP ASI04). Pin only what you
    actually use; treat additions like a dependency PR — review the source,
    the transport, and the tool descriptors before flipping `true`.

    Currently enabled:
    - github: wraps `gh` for issue/PR ops; runs the local `gh` binary.
    - commit-commands: local slash-command bundle for commit hygiene.
    - security-guidance: local prompt/skill bundle, no network.
    - context7 (opt-in via include_context7): remote MCP at
      https://mcp.context7.com/mcp — fetches current library docs. External
      service: prompts/queries leave the sandbox. #}
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
{%- if include_context7 %},
    "context7@claude-plugins-official": true
{%- endif %}
  }
}
