# Task runner — run `just` (or `just --list`) to see all recipes.
# https://github.com/casey/just

set shell := ["bash", "-cu"]

# Show available recipes
default:
    @just --list

# Create the venv, install all deps and the git hooks
install:
    uv sync
    uv run pre-commit install

# Sync the environment from the lockfile
sync:
    uv sync

# Full quality gate (this is what CI runs)
qa: lint test

# Run all pre-commit hooks across the whole repo
lint:
    uv run pre-commit run --all-files

# Auto-format and auto-fix
format:
    uv run ruff format .
    uv run ruff check --fix .

# Static type checking
typecheck:
    uv run mypy .

# Run the test suite (e.g. `just test tests/test_smoke.py`)
{% raw %}test *args:
    uv run pytest {{ args }}{% endraw %}

# Run tests with a coverage report
cov:
    uv run pytest --cov --cov-report=term-missing

# Serve the docs locally with live reload
docs:
    uv run mkdocs serve

# Build the static docs site (fails on warnings)
docs-build:
    uv run mkdocs build --strict

# Pull the latest changes from the Copier template into this project
update:
    uv run copier update --trust --skip-answered --skip-tasks

# Remove caches and build artifacts
clean:
    rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov site dist build .coverage
    find . -type d -name __pycache__ -exec rm -rf {} +

# Create a pre-agent checkpoint tag (use before letting an agent run autonomously)
agent-checkpoint:
    @git diff --quiet HEAD || { echo "Uncommitted changes — commit (or stash) first; the checkpoint tags HEAD."; exit 1; }
    @ts=$(date +%Y%m%d-%H%M%S); \
     git tag "pre-agent-$ts" && \
     echo "Tagged pre-agent-$ts on $(git rev-parse --short HEAD)"
{%- if include_sandbox %}

# --- Sandbox (Docker-Compose) ----------------------------------------------

# Build (or rebuild) the agent sandbox image
sandbox-build:
    docker compose build agent

# Generate any missing sandbox secrets into .env — idempotent, safe to re-run
sandbox-init:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "==> sandbox-init: checking .env for missing secrets …"
    if ! command -v openssl >/dev/null 2>&1; then
        echo "ERROR: openssl not found on PATH. Required for secret generation." >&2
        echo "  Install via your package manager (e.g. 'apt install openssl' / 'brew install openssl')," >&2
        echo "  or set the secrets manually in .env — see docker/README.md." >&2
        exit 1
    fi
    touch .env
    _gen() {
        local key=$1 len=${2:-32}
        if ! grep -qE "^${key}=.+" .env 2>/dev/null; then
            printf '%s=%s\n' "$key" "$(openssl rand -hex $len)" >> .env
            echo "  + ${key} (generated)"
        else
            echo "  ~ ${key} (already set)"
        fi
    }
    _gen SEARXNG_SECRET
{% if include_crawl4ai %}
    _gen CRAWL4AI_API_TOKEN
{% endif %}
{% if sandbox_observability == 'langfuse' %}
    _gen LANGFUSE_ENCRYPTION_KEY
    _gen LANGFUSE_NEXTAUTH_SECRET
    _gen LANGFUSE_SALT
    _gen LANGFUSE_DB_PASSWORD 16
    _gen LANGFUSE_CLICKHOUSE_PASSWORD 16
    _gen LANGFUSE_REDIS_AUTH 16
    _gen LANGFUSE_MINIO_ROOT_PASSWORD 16
{% endif %}
    echo "Done — secrets written to .env (never committed, already in .gitignore)"

# Opt in to selected host-level agent instructions via read-only bind mounts.
# Creates a local, git-ignored Compose override and never edits repository rules.
sandbox-enable-user-instructions:
    #!/usr/bin/env bash
    set -euo pipefail

    override="docker-compose.override.yml"
    marker="# Generated by 'just sandbox-enable-user-instructions'. Local and git-ignored."

    if [[ -e "$override" || -L "$override" ]]; then
        if [[ -f "$override" ]] && grep -Fxq "$marker" "$override"; then
            echo "Already enabled: $override"
            echo "Remove that local file and rerun this recipe to refresh detected sources."
            exit 0
        fi
        echo "ERROR: $override already exists and is not managed by this recipe; refusing to overwrite it." >&2
        exit 1
    fi

    sources=()
    source_count=0
    claude_md=false
    claude_rules=false
    codex_file=""
{% if 'claude_code' in coding_agents %}
    if [[ -f "$HOME/.claude/CLAUDE.md" ]]; then
        sources+=("$HOME/.claude/CLAUDE.md")
        ((source_count += 1))
        claude_md=true
    fi
    if [[ -d "$HOME/.claude/rules" ]]; then
        sources+=("$HOME/.claude/rules/")
        ((source_count += 1))
        claude_rules=true
    fi
{% endif %}
{% if 'codex' in coding_agents %}
    if [[ -f "$HOME/.codex/AGENTS.override.md" ]]; then
        sources+=("$HOME/.codex/AGENTS.override.md")
        ((source_count += 1))
        codex_file="AGENTS.override.md"
    elif [[ -f "$HOME/.codex/AGENTS.md" ]]; then
        sources+=("$HOME/.codex/AGENTS.md")
        ((source_count += 1))
        codex_file="AGENTS.md"
    fi
{% endif %}

    if (( source_count == 0 )); then
        echo "No supported global instruction files found for the selected agents." >&2
        echo "Expected standard user-scope paths such as ~/.claude/CLAUDE.md, ~/.claude/rules/," >&2
        echo "or ~/.codex/AGENTS.override.md / ~/.codex/AGENTS.md." >&2
        exit 1
    fi

    echo "The following host instructions will be visible inside the sandbox (read-only):"
    printf '  - %s\n' "${sources[@]}"
    printf 'Create local %s? [y/N] ' "$override"
    if ! read -r answer; then
        echo
        echo "Cancelled."
        exit 1
    fi
    case "$answer" in
        y|Y|yes|YES) ;;
        *) echo "Cancelled."; exit 1 ;;
    esac

    {
        printf '%s\n' "$marker"
        printf '%s\n' "# Contains host paths only; never commit this file."
        printf '%s\n' "services:" "  agent:" "    volumes:"
        if [[ "$claude_md" == true ]]; then
            printf '%s\n' \
              "      - type: bind" \
              '        source: "${HOME}/.claude/CLAUDE.md"' \
              "        target: /home/agent/.claude/CLAUDE.md" \
              "        read_only: true"
        fi
        if [[ "$claude_rules" == true ]]; then
            printf '%s\n' \
              "      - type: bind" \
              '        source: "${HOME}/.claude/rules"' \
              "        target: /home/agent/.claude/rules" \
              "        read_only: true"
        fi
        if [[ "$codex_file" == "AGENTS.override.md" ]]; then
            printf '%s\n' \
              "      - type: bind" \
              '        source: "${HOME}/.codex/AGENTS.override.md"' \
              "        target: /home/agent/.codex/AGENTS.override.md" \
              "        read_only: true"
        elif [[ "$codex_file" == "AGENTS.md" ]]; then
            printf '%s\n' \
              "      - type: bind" \
              '        source: "${HOME}/.codex/AGENTS.md"' \
              "        target: /home/agent/.codex/AGENTS.md" \
              "        read_only: true"
        fi
        # Protect the local override from writes by processes in the container.
        printf '%s\n' \
          "      - type: bind" \
          "        source: ./docker-compose.override.yml" \
          "        target: /workspace/docker-compose.override.yml" \
          "        read_only: true"
    } > "$override"
    chmod 600 "$override"

    echo "Enabled via $override. Repository AGENTS.md / CLAUDE.md were not modified."
    echo "Remove $override to disable the host instruction mounts."

# Start supporting services (searxng{% if sandbox_observability != 'none' %} + {{ sandbox_observability }}{% endif %}) in the background
sandbox-up:{% if sandbox_auto_init %} sandbox-init{% endif %}
    docker compose --profile dev{% if sandbox_observability != 'none' %} --profile trace{% endif %} up -d

# Drop into an interactive shell inside the agent container
sandbox-shell:
    docker compose --profile dev run --rm agent bash

# Tear everything down (containers + networks; volumes stay)
sandbox-down:
    docker compose --profile dev{% if sandbox_observability != 'none' %} --profile trace{% endif %} down

# Remove sandbox volumes too (caches, observability data) — destructive
sandbox-nuke:
    docker compose --profile dev{% if sandbox_observability != 'none' %} --profile trace{% endif %} down -v
{%- endif %}
