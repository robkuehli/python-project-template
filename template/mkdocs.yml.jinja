site_name: {{ project_name }}
site_description: {{ project_description }}
site_url: https://{{ github_username }}.github.io/{{ project_slug }}/
repo_url: https://github.com/{{ github_username }}/{{ project_slug }}
repo_name: {{ github_username }}/{{ project_slug }}

theme:
  name: material
  features:
    - navigation.sections
    - navigation.top
    - content.code.copy
    - search.suggest
  palette:
    - scheme: default
      toggle:
        icon: material/weather-night
        name: Switch to dark mode
    - scheme: slate
      toggle:
        icon: material/weather-sunny
        name: Switch to light mode

plugins:
  - search
  - mkdocstrings:
      handlers:
        python:
          paths: [src]
          options:
            docstring_style: google
            show_source: true
            show_root_heading: true

nav:
  - Home: index.md
  - Explanation:
      - Tools &amp; architecture: explanation/tools.md
      - Developer workflow: explanation/developer-workflow.md
      - Working with agents: explanation/working-with-agents.md
      - Context compression (optional): explanation/context-compression.md
{%- if 'opencode' in coding_agents and include_opencode_learning_inbox %}
      - OpenCode Learning-Inbox (optional): explanation/learning-loop.md
{%- endif %}
{%- if include_sandbox %}
      - The agent sandbox: explanation/sandbox.md
{%- endif %}
  - How-to guides:
      - Project tasks: how-to/project-tasks.md
{%- if include_sandbox %}
      - Run the sandbox: how-to/run-the-sandbox.md
{%- endif %}
{%- if sdd_framework != 'none' %}
      - Spec-driven development: how-to/spec-driven-development.md
{%- endif %}
  - Reference:
      - Tools: reference/tools.md
      - API: reference/{{ package_name }}.md
{%- if include_sandbox %}
      - Sandbox: reference/sandbox.md
{%- endif %}
  - Skills:
      - Overview: skills/README.md
      - /explore: skills/explore/SKILL.md
      - /spec: skills/spec/SKILL.md
      - /plan: skills/plan/SKILL.md
      - /test: skills/test/SKILL.md
      - /delegate: skills/delegate/SKILL.md
      - /review: skills/review/SKILL.md
      - /verify: skills/verify/SKILL.md
      - /debug: skills/debug/SKILL.md
      - /capture: skills/capture/SKILL.md
  - Guidelines:
      - Testing: guidelines/testing.md
      - Documentation: guidelines/documentation.md
      - Changelog standards: guidelines/changelog.md
  - Changelog: changelog.md

markdown_extensions:
  - admonition
  - toc:
      permalink: true
  - pymdownx.highlight
  - pymdownx.superfences
  - pymdownx.snippets:
      base_path: ["."]
