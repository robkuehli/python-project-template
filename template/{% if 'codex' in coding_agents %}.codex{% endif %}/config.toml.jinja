# Codex CLI — project-scoped config. Merges with `~/.codex/config.toml`;
# user-level keys win for auth/provider/profile-selection (see project-scope
# constraint in the schema). Defaults below mirror the maintainer-recommended
# interactive setup; for CI, prefer flags on `codex exec` over editing here:
#
#   codex exec --sandbox read-only --ask-for-approval untrusted ...
#
# Schema: https://developers.openai.com/codex/config-reference

# GPT-5.6 is the current recommended Codex model. Override per-session with
# `/model` or `--model`.
model = "gpt-5.6"

# "medium" is the documented all-day driver; "xhigh" can cost 3–5× tokens.
# Override per-session with `/effort` or `--reasoning-effort`.
model_reasoning_effort = "medium"

# The :workspace permission profile supplies the workspace-write sandbox;
# current Codex forbids combining `default_permissions` with `sandbox_mode`.
# `on-request` keeps escalation available for commands outside that profile.
# https://developers.openai.com/codex/agent-approvals-security
#
# This template does not install a separate execpolicy ruleset. The shared
# destructive-command patterns remain in AGENTS.md, while pre-commit
# (gitleaks, detect-private-key) provides the hard secret-scanning backstop.
approval_policy = "on-request"
default_permissions = ":workspace"

# --- Feature flags ----------------------------------------------------------
# Multi-agent tools, hooks, unified exec, and shell snapshots are already on
# by default. Memories are opt-in, so enable only that non-default feature.
[features]
memories = true

# Custom subagents are auto-discovered from `.codex/agents/*.toml`.

# --- Hooks ------------------------------------------------------------------
# Stop hook: reminds about the "Verify" stage of Plan-Execute-Verify when a
# session ends with uncommitted diff. SOFT-WARN by default; opt-in HARD-BLOCK
# via `export CODEX_VERIFY_HARD_BLOCK=1` — then the turn is blocked until
# `just qa` passes.
#
# Reference: https://developers.openai.com/codex/hooks
[[hooks.Stop]]
[[hooks.Stop.hooks]]
type = "command"
command = '"$(git rev-parse --show-toplevel)/.codex/hooks/verify-on-stop.sh"'
{%- if include_context7 %}

# --- MCP servers ------------------------------------------------------------
# Context7 fetches up-to-date library docs into the model context — solves the
# stale-training-data problem for Python libs. Opt-in via include_context7.
# Requires Node on PATH; queries leave the sandbox (external service).
[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp@{{ tool_versions.context7 }}"]
{%- endif %}
