name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  qa:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6

      - name: Set up uv + Python
        # setup-uv v8 stopped publishing moving major/minor tags as a
        # supply-chain hardening measure — pin to a full version and bump
        # deliberately. See https://github.com/astral-sh/setup-uv/releases.
        uses: astral-sh/setup-uv@v8.2.0
        with:
          python-version: "{{ python_version }}"
          enable-cache: true

      - name: Install dependencies
        run: uv sync --all-groups

      - name: Pre-commit (lint, format, type-check, security)
        run: uv run pre-commit run --all-files --show-diff-on-failure

      - name: Tests
        run: uv run pytest --cov --cov-report=term-missing
