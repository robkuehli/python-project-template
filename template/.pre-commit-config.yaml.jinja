# See https://pre-commit.com for more information
default_language_version:
  python: python{{ python_version }}

repos:
  # Generic hygiene (whitespace, EOLs, YAML/TOML sanity, merge conflicts, etc.)
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: 3e8a8703264a2f4a69428a0aa4dcb512790b2c8c  # v6.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
        # Copier owns this file and currently writes one additional blank line.
        exclude: ^\.copier-answers\.yml$
      - id: check-yaml
      - id: check-toml
      - id: check-merge-conflict
      - id: check-added-large-files
      - id: detect-private-key

  # Ruff (lint + format)
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: 7c55798a78262d14b2074abf623d8a992ebb70d4  # v0.16.2
    hooks:
      - id: ruff
        args: [--fix, --exit-non-zero-on-fix]
      - id: ruff-format

  # Bandit (security linter)
  - repo: https://github.com/PyCQA/bandit
    rev: 92ae8b82fb422a639f0ed8d99e96cea769594e08  # 1.9.4
    hooks:
      - id: bandit
        # explizit .venv & build-Artefakte ausklammern, damit Bandit nicht die
        # gesamten site-packages scannt (reduziert Lärm im Output)
        args: ["-c", "pyproject.toml", "-r", ".", "--exclude", "./.venv,./site"]
        pass_filenames: false

  # Gitleaks (secret scanning)
  - repo: https://github.com/gitleaks/gitleaks
    rev: 83d9cd684c87d95d656c1458ef04895a7f1cbd8e  # v8.30.1
    hooks:
      - id: gitleaks
        pass_filenames: false
        # args: ["--config=.gitleaks.toml"]  # uncomment to use the bundled config

  # Local (run in *your* environment so imports / dependency resolution work)
  - repo: local
    hooks:
      - id: mypy
        name: mypy (type-check)
        entry: mypy --config-file pyproject.toml .
        language: system
        pass_filenames: false
        types: [python]

      - id: pylint
        name: pylint (lint)
        entry: pylint --rcfile=pyproject.toml
        language: system
        types: [python]
        # Argumente an pylint:
        #   - -rn: keine "Reports", nur Messages
        #   - --disable=W0621: disable "redefined-outer-name"
        #   - --fail-under=9: brich ab, wenn Score < 9
        args:
          [
            "-rn",
            "--disable=W0621",
            "--fail-under=9",
          ]
{%- if include_sql %}

      - id: sqlfluff-lint
        name: sqlfluff (lint SQL)
        entry: sqlfluff lint --config pyproject.toml
        language: system
        types: [sql]
{%- endif %}

      - id: interrogate
        name: interrogate (docstring coverage)
        entry: interrogate -c pyproject.toml
        language: system
        pass_filenames: false
        types: [python]

      # pytest is intentionally NOT a pre-commit hook:
      #   - `always_run: true` would slow every commit, even doc-only changes.
      #   - It is enforced in CI (`.github/workflows/ci.yml`) and runs locally
      #     via `just test` / `just qa` — both are the verify gate before commit.
