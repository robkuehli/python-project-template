# GitLab CI baseline for {{ project_name }}.
#
# A generic Python template cannot know whether the generated project is a
# library, service, container, or deployable application. The pipeline therefore
# enforces only the repository's universal gates. Add packaging or deployment
# jobs in the generated project once its delivery target is known.

stages:
  - qa
  - docs

default:
  image: python:{{ python_version }}-slim-bookworm@sha256:{% if python_version == '3.12' %}4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2{% elif python_version == '3.13' %}00faa2debb87529f9f0764e9491d8ba400a3678976616c3bd7cb193745ac20d1{% else %}23c59390fc717bf09f9336908199a0ae75d9c4264bf296123f94ad772fea3b52{% endif %}
  before_script:
    - pip install --quiet uv=={{ tool_versions.uv }}
    - UV_TOOL_BIN_DIR=/usr/local/bin uv tool install rust-just=={{ tool_versions.just }}
    - uv sync --all-groups --frozen

# Canonical code-quality gate: lint, security checks, strict typing, and tests.
qa:
  stage: qa
  script:
    - just qa

# Build documentation strictly so broken links and warnings fail the pipeline.
docs:
  stage: docs
  script:
    - just docs-build
