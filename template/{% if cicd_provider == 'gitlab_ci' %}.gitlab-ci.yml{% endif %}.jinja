# =============================================================================
# GitLab CI/CD pipeline for {{ project_name }}
# Generated by python-project-template — edit deliberately.
# =============================================================================
#
# Pipeline stages (run top to bottom, each blocks the next):
#
#   lint    All pre-commit hooks *except* tests (ruff, mypy, pylint, bandit,
#           gitleaks, …). Runs on every push and merge request.
#   test    pytest. Runs on every push and merge request.
#   build   Builds the Docker image and stores it as a .tar artifact.
#   push    Publishes the image to the container registry.
#   deploy  Rolls the image out to Kubernetes (manual trigger).
#
# Where things run
# ----------------
#   lint + test           → every ref (feature branches, merge requests, …).
#   build + push + deploy  → PROTECTED refs only ($CI_COMMIT_REF_PROTECTED).
#
#   Protected refs (protected branches + protected tags) are the only place
#   GitLab exposes protected CI/CD variables. Gating build/push/deploy on them
#   means the registry and the cluster are never touched from an unreviewed
#   feature branch — this is a security boundary, not just a convenience.
#
# Image tagging & rollback
# ------------------------
#   Every protected pipeline publishes an IMMUTABLE image tagged with the
#   commit SHA ($CI_COMMIT_SHORT_SHA). That SHA tag is the rollback anchor:
#   one image per commit, never overwritten. Release tags additionally get a
#   version tag and move `latest`. `latest` is a convenience pointer and is
#   NEVER a rollback target — always roll back to a SHA or a version tag.
#
#   Deploy always rolls out the SHA image, so a rollout is deterministic.
#   Roll back with `kubectl rollout undo deployment/{{ project_slug }}`
#   or by re-running deploy on an earlier commit's pipeline.
#
# Required CI/CD variables (Settings → CI/CD → Variables)
# -------------------------------------------------------
#   KUBE_CONFIG   base64-encoded kubeconfig. Mark as Protected + Masked so it
#                 is only available to the protected-ref deploy job.
#
#   Registry credentials ($CI_REGISTRY_*) are provided by GitLab automatically.
#   Override REGISTRY_IMAGE to push to a registry other than the built-in one.
# =============================================================================

stages:
  - lint
  - test
  - build
  - push
  - deploy

variables:
  # Registry to publish to. Defaults to this project's built-in GitLab registry.
  REGISTRY_IMAGE: $CI_REGISTRY_IMAGE
  # Immutable per-commit image reference — the rollback anchor (see header).
  IMAGE_SHA: $CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA
  # Filename for the image handed from `build` to `push` as an artifact.
  IMAGE_TAR: image-$CI_COMMIT_SHORT_SHA.tar

# Shared Python setup for the lint and test jobs.
.python:
  image: python:{{ python_version }}-slim
  before_script:
    - pip install --quiet uv
    - uv sync --all-groups

# Reusable gate: run only on protected branches and protected tags.
.on-protected:
  rules:
    - if: '$CI_COMMIT_REF_PROTECTED == "true"'

# -----------------------------------------------------------------------------
# lint — every pre-commit hook except tests.
# --hook-stage commit runs only commit-stage hooks; pytest is not wired into
# pre-commit in this template, and this flag keeps it that way even if someone
# later adds a push-stage test hook.
# -----------------------------------------------------------------------------
lint:
  stage: lint
  extends: .python
  script:
    - uv run pre-commit run --all-files --hook-stage commit --show-diff-on-failure

# -----------------------------------------------------------------------------
# test — run the test suite.
# -----------------------------------------------------------------------------
test:
  stage: test
  extends: .python
  script:
    - uv run pytest

# -----------------------------------------------------------------------------
# build — build the Docker image and hand it on as a .tar artifact.
# Docker-in-Docker is the canonical GitLab pattern for building images.
# Protected refs only — a build here always feeds push, so building elsewhere
# would just discard the artifact.
# -----------------------------------------------------------------------------
build:
  stage: build
  extends: .on-protected
  image: docker:27
  services:
    - docker:27-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  script:
    - docker build
        --build-arg PYTHON_VERSION={{ python_version }}
        --tag "$IMAGE_SHA"
        --file docker/agent/Dockerfile
        .
    - docker save "$IMAGE_SHA" -o "$IMAGE_TAR"
  artifacts:
    paths:
      - "$IMAGE_TAR"
    expire_in: 1 day

# -----------------------------------------------------------------------------
# push — load the built image and publish it to the registry.
# Always pushes the immutable SHA tag. On a release tag it additionally
# publishes the version tag and moves `latest`.
# -----------------------------------------------------------------------------
push:
  stage: push
  extends: .on-protected
  image: docker:27
  services:
    - docker:27-dind
  variables:
    DOCKER_TLS_CERTDIR: "/certs"
  needs:
    - job: build
      artifacts: true
  script:
    - docker load -i "$IMAGE_TAR"
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"
    # Rollback anchor: one immutable image per commit.
    - docker push "$IMAGE_SHA"
    # On a release tag, also publish the human-readable version and `latest`.
    - |
      if [ -n "$CI_COMMIT_TAG" ]; then
        docker tag "$IMAGE_SHA" "$REGISTRY_IMAGE:$CI_COMMIT_TAG"
        docker push "$REGISTRY_IMAGE:$CI_COMMIT_TAG"
        docker tag "$IMAGE_SHA" "$REGISTRY_IMAGE:latest"
        docker push "$REGISTRY_IMAGE:latest"
      fi

# -----------------------------------------------------------------------------
# deploy — roll the image out to Kubernetes.
# Protected refs only, and MANUAL: a human clicks "play" in the pipeline.
# Deploys the immutable SHA image so the rollout is reproducible.
# -----------------------------------------------------------------------------
deploy:
  stage: deploy
  image: bitnami/kubectl:latest
  needs:
    - job: push
  rules:
    - if: '$CI_COMMIT_REF_PROTECTED == "true"'
      when: manual
  script:
    - mkdir -p ~/.kube
    - echo "$KUBE_CONFIG" | base64 -d > ~/.kube/config
    - kubectl set image deployment/{{ project_slug }}
        {{ project_slug }}="$IMAGE_SHA"
        --namespace={{ project_slug }}
    # Fail the job (and signal the operator to roll back) if the new pods
    # don't become healthy within the timeout.
    - kubectl rollout status deployment/{{ project_slug }}
        --namespace={{ project_slug }} --timeout=120s
  environment:
    name: production
    url: https://{{ project_slug }}.example.com
