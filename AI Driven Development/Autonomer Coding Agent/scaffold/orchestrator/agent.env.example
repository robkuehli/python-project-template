# agent.env.example — nach agent.env kopieren und anpassen. Wird von run-agent.sh gesourced.

# --- Modelle ---------------------------------------------------------------
# Lokaler Default-Worker. Refresh-Kandidaten Mai 2026: qwen3-coder-next, qwen3.5:27b.
LOCAL_MODEL="ollama/qwen3-coder:30b"

# Eskalations-Modelle in Reihenfolge. Jeder Eintrag = eine budget-gated Cloud-Eskalation.
# Cloud-Tags gegen `ollama list` / ollama.com/search?c=cloud verifizieren.
CLOUD_ESCALATION_MODELS="ollama/qwen3-coder-next-cloud ollama/glm-5.1-cloud"

# --- Parallelitaet & Zeit --------------------------------------------------
LOCAL_PARALLEL=3
ATTEMPT_TIMEOUT=5400          # 90 min pro lokalem Versuch (Wall-Clock, via timeout)
CLOUD_ATTEMPT_TIMEOUT=3600    # 60 min pro Cloud-Versuch

# --- Optionale Planner/Reviewer-Schicht (ADR-011) -------------------------
# on  -> plan/reviewer laufen auf guenstigem Cloud-Open-Weight (opencode-autonomous-planreview.json)
# off -> alles lokal
PLANNER_REVIEWER=off

# --- Budget (Eskalations-Kontingent, KEIN Euro-Meter solange Ollama subscription-basiert) --
MAX_CLOUD_PER_DAY=4
MAX_CLOUD_PER_WEEK=15
# CLOUD_LEDGER="$HOME/.config/agent/cloud-ledger.json"

# --- Ollama ----------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434/v1"   # Host. Sandbox-Wrapper setzt host.docker.internal selbst.
OLLAMA_API_KEY="REPLACE_WITH_OLLAMA_CLOUD_KEY" # fuer Cloud noetig; lokal genuegt Platzhalter

# --- Sandbox-Limits --------------------------------------------------------
SANDBOX_CPUS=2.8              # ~70% von 4 P-Cores (M4 Pro) gegen thermisches Throttling
SANDBOX_MEM=6g
AGENT_SANDBOX_IMAGE="agent-sandbox:latest"
OPENCODE_ENABLE_EXA=true      # native Web-Suche (Exa) im Container aktiv

# --- Notifications (alternativ in ~/.config/agent/notify.env, mode 600) ----
# NOTIFY_PROVIDER=pushover
# PUSHOVER_USER=...
# PUSHOVER_TOKEN=...
