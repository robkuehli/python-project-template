{
  "$schema": "https://opencode.ai/config.json",

  "_comment": "Profil: Balanced (Default). Standard-Arbeitstag, kostenbewusst. Aktivierung: OPENCODE_CONFIG=~/.config/opencode/configs/opencode-balanced.json opencode (Alias: oc).",

  "instructions": [
    "AGENTS.md",
    "LEARNINGS.md"
  ],

  "provider": {
    "litellm": {
      "name": "LiteLLM (Firmen-Proxy)",
      "baseURL": "https://litellm.internal.example.com/v1",
      "apiKey": "{env:LITELLM_API_KEY}",
      "models": {
        "claude-opus-4-7":         { "name": "Claude Opus 4.7" },
        "claude-sonnet-4-6":       { "name": "Claude Sonnet 4.6" },
        "claude-haiku-4-5":        { "name": "Claude Haiku 4.5" },
        "azure-gpt-5-eu":          { "name": "GPT-5 (Azure EU)" },
        "azure-gpt-5-mini-eu":     { "name": "GPT-5 mini (Azure EU)" }
      }
    },
    "ollama": {
      "name": "Ollama (lokal)",
      "baseURL": "http://localhost:11434/v1",
      "apiKey": "{env:OLLAMA_API_KEY}",
      "models": {
        "llama3.2:3b": { "name": "Llama 3.2 3B (lokal, fallback small_model)" }
      }
    }
  },

  "model": "litellm/claude-sonnet-4-6",
  "small_model": "litellm/claude-haiku-4-5",

  "max_concurrent_tasks": 2,

  "agent": {
    "build":            { "model": "litellm/claude-sonnet-4-6" },
    "plan":             { "model": "litellm/claude-sonnet-4-6" },
    "reviewer":         { "model": "litellm/claude-sonnet-4-6" },
    "researcher":       { "model": "litellm/claude-haiku-4-5" },
    "security-auditor": { "model": "litellm/claude-sonnet-4-6" }
  },

  "permissions": {
    "edit":  "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "git push *":   "ask",
      "git rebase *": "ask",
      "git reset *":  "ask",
      "git merge *":  "ask",
      "rm -rf *":     "deny",
      "rm -rf*":      "deny",
      "sudo rm *":    "deny",
      "chmod 777*":   "deny",
      "curl * | bash": "deny",
      "wget * | bash": "deny",
      "curl * | sh":   "deny",
      "DROP TABLE*":   "deny",
      "TRUNCATE*":     "deny"
    },
    "read": {
      "*": "allow",
      "**/.env":          "deny",
      "**/.env.*":        "deny",
      "**/secrets.*":     "deny",
      "**/*secret*":      "deny",
      "**/*credentials*": "deny",
      "**/id_rsa*":       "deny",
      "**/id_ed25519*":   "deny",
      "**/*.pem":         "deny",
      "**/*.key":         "deny"
    },
    "webfetch": "ask"
  }
}
