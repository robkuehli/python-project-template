{
  "$schema": "https://opencode.ai/config.json",

  "_comment": "Profil: Ollama. Lokal + Cloud Open-Weight. Voraussetzung: ollama signin ausgeführt, OLLAMA_API_KEY in env. Lokale Modelle vorab via 'ollama pull' ziehen. NICHT für DSGVO-Daten (Ollama Cloud = US). Aktivierung: oc-ollama.",

  "instructions": [
    "AGENTS.md",
    "LEARNINGS.md"
  ],

  "provider": {
    "ollama": {
      "name": "Ollama (lokal + Cloud)",
      "baseURL": "http://localhost:11434/v1",
      "apiKey": "{env:OLLAMA_API_KEY}",
      "models": {
        "qwen3-coder:30b":          { "name": "Qwen3 Coder 30B (lokal)" },
        "qwen3-coder-64k":          { "name": "Qwen3 Coder 30B (lokal, 64K Context)" },
        "deepseek-r1:14b":          { "name": "DeepSeek R1 14B (lokal)" },
        "llama3.2:3b":              { "name": "Llama 3.2 3B (lokal, small_model)" },
        "gpt-oss:120b-cloud":       { "name": "gpt-oss 120B (Ollama Cloud)" },
        "gpt-oss:20b-cloud":        { "name": "gpt-oss 20B (Ollama Cloud)" },
        "qwen3-coder:480b-cloud":   { "name": "Qwen3 Coder 480B (Ollama Cloud)" },
        "deepseek-v3.1:671b-cloud": { "name": "DeepSeek V3.1 671B (Ollama Cloud)" },
        "kimi-k2-cloud":            { "name": "Kimi K2 (Ollama Cloud)" }
      }
    }
  },

  "model": "ollama/qwen3-coder:480b-cloud",
  "small_model": "ollama/llama3.2:3b",

  "max_concurrent_tasks": 2,

  "agent": {
    "build":            { "model": "ollama/qwen3-coder:480b-cloud" },
    "plan":             { "model": "ollama/gpt-oss:120b-cloud" },
    "reviewer":         { "model": "ollama/gpt-oss:120b-cloud" },
    "researcher":       { "model": "ollama/qwen3-coder:30b" },
    "security-auditor": { "model": "ollama/gpt-oss:120b-cloud" }
  },

  "permissions": {
    "edit":  "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "git push *":   "ask",
      "git rebase *": "ask",
      "git reset *":  "ask",
      "git merge *":  "ask",
      "rm -rf *":     "deny",
      "rm -rf*":      "deny",
      "sudo rm *":    "deny",
      "chmod 777*":   "deny",
      "curl * | bash": "deny",
      "wget * | bash": "deny",
      "curl * | sh":   "deny",
      "DROP TABLE*":   "deny",
      "TRUNCATE*":     "deny"
    },
    "read": {
      "*": "allow",
      "**/.env":          "deny",
      "**/.env.*":        "deny",
      "**/secrets.*":     "deny",
      "**/*secret*":      "deny",
      "**/*credentials*": "deny",
      "**/id_rsa*":       "deny",
      "**/id_ed25519*":   "deny",
      "**/*.pem":         "deny",
      "**/*.key":         "deny"
    },
    "webfetch": "ask"
  },

  "_hardware_notes": [
    "M4 Pro 48 GB: qwen3-coder:30b läuft flüssig (~18 GB), gpt-oss:120b-cloud via Cloud (kein lokales RAM).",
    "M1 Pro 32 GB: qwen3-coder:14b statt 30b für lokal — siehe Folge-Session zu Autonomer Coding Agent.",
    "deepseek-r1:14b als Reasoning-Alternative zu gpt-oss:120b-cloud, wenn Cloud-Limit erreicht oder offline."
  ]
}
