{
  "$schema": "https://opencode.ai/config.json",

  "_comment": "Profil: DSGVO. EU-Datenresidenz und EU-Inferenz. Bedrock EU (eu-central-1) für Claude, Azure AI Foundry EU für GPT, lokales Ollama für Trivial-Tasks. KEIN Azure-Foundry-Claude (läuft Stand Mai 2026 trotz EU-Deployment auf US-Servern). Aktivierung: oc-dsgvo.",

  "instructions": [
    "AGENTS.md",
    "LEARNINGS.md"
  ],

  "provider": {
    "litellm": {
      "name": "LiteLLM (Firmen-Proxy, EU-Endpoints)",
      "baseURL": "https://litellm.internal.example.com/v1",
      "apiKey": "{env:LITELLM_API_KEY}",
      "models": {
        "bedrock-claude-opus-eu":   { "name": "Claude Opus 4.7 (Bedrock eu-central-1)" },
        "bedrock-claude-sonnet-eu": { "name": "Claude Sonnet 4.6 (Bedrock eu-central-1)" },
        "bedrock-claude-haiku-eu": { "name": "Claude Haiku 4.5 (Bedrock eu-central-1)" },
        "azure-gpt-5-eu":          { "name": "GPT-5 (Azure AI Foundry, EU)" },
        "azure-gpt-5-mini-eu":     { "name": "GPT-5 mini (Azure AI Foundry, EU)" }
      }
    },
    "ollama": {
      "name": "Ollama (lokal, kein Cloud-Transfer)",
      "baseURL": "http://localhost:11434/v1",
      "models": {
        "llama3.2:3b":     { "name": "Llama 3.2 3B (lokal)" },
        "qwen3-coder:30b": { "name": "Qwen3 Coder 30B (lokal)" }
      }
    }
  },

  "model": "litellm/bedrock-claude-sonnet-eu",
  "small_model": "ollama/llama3.2:3b",

  "max_concurrent_tasks": 2,

  "agent": {
    "build":            { "model": "litellm/bedrock-claude-sonnet-eu" },
    "plan":             { "model": "litellm/bedrock-claude-opus-eu" },
    "reviewer":         { "model": "litellm/bedrock-claude-opus-eu" },
    "researcher":       { "model": "litellm/bedrock-claude-sonnet-eu" },
    "security-auditor": { "model": "litellm/bedrock-claude-opus-eu" }
  },

  "permissions": {
    "edit":  "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "git push *":   "ask",
      "git rebase *": "ask",
      "git reset *":  "ask",
      "git merge *":  "ask",
      "rm -rf *":     "deny",
      "rm -rf*":      "deny",
      "sudo rm *":    "deny",
      "chmod 777*":   "deny",
      "curl * | bash": "deny",
      "wget * | bash": "deny",
      "curl * | sh":   "deny",
      "DROP TABLE*":   "deny",
      "TRUNCATE*":     "deny"
    },
    "read": {
      "*": "allow",
      "**/.env":          "deny",
      "**/.env.*":        "deny",
      "**/secrets.*":     "deny",
      "**/*secret*":      "deny",
      "**/*credentials*": "deny",
      "**/id_rsa*":       "deny",
      "**/id_ed25519*":   "deny",
      "**/*.pem":         "deny",
      "**/*.key":         "deny"
    },
    "webfetch": "ask"
  },

  "_dsgvo_checklist": "Siehe 'OpenCode — Open Issues & TODOs.md' §C — DSGVO-Checkliste pro Kundenprojekt."
}
