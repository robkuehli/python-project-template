{
  "$schema": "https://opencode.ai/config.json",

  "_comment": "Globale OpenCode-Konfiguration. Speicherort im echten Home: ~/.config/opencode/opencode.json. Diese Datei ist die Default-Variante (entspricht 'balanced'). Andere Profile (sota, dsgvo, ollama) liegen unter configs/ und werden per OPENCODE_CONFIG-Env aktiviert.",

  "instructions": [
    "AGENTS.md",
    "LEARNINGS.md"
  ],

  "provider": {
    "litellm": {
      "name": "LiteLLM (Firmen-Proxy)",
      "baseURL": "https://litellm.internal.example.com/v1",
      "apiKey": "{env:LITELLM_API_KEY}",
      "models": {
        "claude-opus-4-7":         { "name": "Claude Opus 4.7" },
        "claude-sonnet-4-6":       { "name": "Claude Sonnet 4.6" },
        "claude-haiku-4-5":        { "name": "Claude Haiku 4.5" },
        "bedrock-claude-opus-eu":  { "name": "Claude Opus 4.7 (Bedrock eu-central-1)" },
        "bedrock-claude-sonnet-eu": { "name": "Claude Sonnet 4.6 (Bedrock eu-central-1)" },
        "bedrock-claude-haiku-eu": { "name": "Claude Haiku 4.5 (Bedrock eu-central-1)" },
        "azure-gpt-5-eu":          { "name": "GPT-5 (Azure AI Foundry, EU-Region)" },
        "azure-gpt-5-mini-eu":     { "name": "GPT-5 mini (Azure AI Foundry, EU-Region)" },
        "gpt-5":                   { "name": "GPT-5 (Azure US)" },
        "gpt-5-mini":              { "name": "GPT-5 mini (Azure US)" },
        "gpt-5-codex":             { "name": "GPT-5 Codex (Azure US)" }
      }
    },
    "ollama": {
      "name": "Ollama (lokal + Cloud)",
      "baseURL": "http://localhost:11434/v1",
      "apiKey": "{env:OLLAMA_API_KEY}",
      "models": {
        "qwen3-coder:30b":         { "name": "Qwen3 Coder 30B (lokal)" },
        "qwen3-coder-64k":         { "name": "Qwen3 Coder 30B (lokal, 64K-Context-Variante)" },
        "deepseek-r1:14b":         { "name": "DeepSeek R1 14B (lokal)" },
        "llama3.2:3b":             { "name": "Llama 3.2 3B (lokal, small_model)" },
        "gpt-oss:120b-cloud":      { "name": "gpt-oss 120B (Ollama Cloud)" },
        "gpt-oss:20b-cloud":       { "name": "gpt-oss 20B (Ollama Cloud)" },
        "qwen3-coder:480b-cloud":  { "name": "Qwen3 Coder 480B (Ollama Cloud)" },
        "deepseek-v3.1:671b-cloud": { "name": "DeepSeek V3.1 671B (Ollama Cloud)" },
        "kimi-k2-cloud":           { "name": "Kimi K2 (Ollama Cloud)" }
      }
    }
  },

  "model": "litellm/claude-sonnet-4-6",
  "small_model": "litellm/claude-haiku-4-5",

  "max_concurrent_tasks": 2,

  "_agent_comment": "Verschlankt 2026-05-21: nur Agents mit echtem Mehrwert ggü. Primary (Kontext-Isolation / unabhängiges read-only-Review / Spezial-Checkliste). Entfernt: planner, debugger, refactorer, docs-writer, test-generator, git-helper — deren Funktion ist als Skill (plan/debug/test/capture) bzw. direkt im build-Mode abgedeckt.",

  "agent": {
    "build":            { "model": "litellm/claude-sonnet-4-6" },
    "plan":             { "model": "litellm/claude-sonnet-4-6" },
    "reviewer":         { "model": "litellm/claude-sonnet-4-6" },
    "researcher":       { "model": "litellm/claude-haiku-4-5" },
    "security-auditor": { "model": "litellm/claude-sonnet-4-6" }
  },

  "permissions": {
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "allow",
      "git push *":   "ask",
      "git rebase *": "ask",
      "git reset *":  "ask",
      "git merge *":  "ask",
      "rm -rf *":     "deny",
      "rm -rf*":      "deny",
      "sudo rm *":    "deny",
      "chmod 777*":   "deny",
      "curl * | bash": "deny",
      "wget * | bash": "deny",
      "curl * | sh":   "deny",
      "DROP TABLE*":   "deny",
      "TRUNCATE*":     "deny"
    },
    "read": {
      "*": "allow",
      "**/.env":          "deny",
      "**/.env.*":        "deny",
      "**/secrets.*":     "deny",
      "**/*secret*":      "deny",
      "**/*credentials*": "deny",
      "**/id_rsa*":       "deny",
      "**/id_ed25519*":   "deny",
      "**/*.pem":         "deny",
      "**/*.key":         "deny"
    },
    "webfetch": "ask"
  },

  "_todo": "Offene Punkte zentral gepflegt in 'OpenCode — Open Issues & TODOs.md' (ruff-format + PreBash-Guard erledigt via plugin/learnings-and-guards.ts)."
}
