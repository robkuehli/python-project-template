# _dev justfile — Template-Smoketests + Doku-Rezepte.
# Das gerenderte Projekt hat sein eigenes justfile (siehe
# template/justfile.jinja).
#
# Invoke from repo root: `just --justfile _dev/justfile <recipe>`.
# `set working-directory` pins all recipe paths to the repo root regardless of
# where `just` is invoked from.

set working-directory := ".."

default:
    @just --list

# --- Template docs site -----------------------------------------------------
# Docs for the template itself (_dev/docs/). The generated project has its own
# docs site rendered from template/mkdocs.yml.jinja.

# Serve the template docs locally with live reload.
docs:
    uv run --with 'mkdocs-material==9.7.7' \
        mkdocs serve -f _dev/mkdocs.yml

# Strict build into _dev/site/.
docs-build:
    uv run --with 'mkdocs-material==9.7.7' \
        mkdocs build --strict -f _dev/mkdocs.yml

# Notes:
# - Test 1: Claude-Code-only, kein Sandbox (Minimal-Pfad).
# - Test 2: Full-Stack mit Langfuse v3 + Crawl4AI — aktiviert alle
#   profil-gegateten `:?`-Guards (SEARXNG_SECRET, CRAWL4AI_API_TOKEN,
#   LANGFUSE_ENCRYPTION_KEY, LANGFUSE_NEXTAUTH_SECRET).
# - Test 3: Full-Stack mit MLflow — anderer Compose-Jinja-Branch
#   (`elif sandbox_observability == 'mlflow'`) als Langfuse und der
#   eigentliche copier.yml-Default.
# - Test 4: Alle 5 Agents + Context7 + Python 3.14 — deckt Codex-Config,
#   granular OpenCode permissions, Context7-conditional, und 3.14-Pins ab.
# - Test 5: Codex(LiteLLM) + OpenCode(hybrid) + Context7=false + Python 3.12 —
#   deckt Codex-LiteLLM-AGENTS.md-Text, OpenCode-hybrid-Modellblock,
#   Context7-Else-Branch und 3.12-Pins ab (kein Sandbox → schnell).
# - Test 6/7: GitLab-CI bzw. kein CI/CD.
# - Test 8: Pi-only + Spec-Kit — deckt Pi-Auswahl, `.agents/skills` und den
#   verbleibenden SDD-Branch ab.
# - Compose-Check braucht `--profile dev --profile trace` — sonst
#   filtert Compose alle profil-gegateten Services raus und der Test
#   wird zum False-Pass (Output `services: {}`).
# - `--defaults` koppelt den Test an die aktuellen copier.yml-Defaults:
#   eine Default-Verschiebung verschiebt den Coverage-Scope mit, ohne
#   dass der Test rot wird.

# Render-Smoketest: acht Copier-Szenarien + Config- + Compose-Validierung.
# Run from repo root: `just -f _dev/justfile render-test`.
render-test:
    #!/usr/bin/env bash
    set -euo pipefail

    rm -rf /tmp/render-test-1 /tmp/render-test-2 /tmp/render-test-3 /tmp/render-test-4 /tmp/render-test-5 /tmp/render-test-6 /tmp/render-test-7 /tmp/render-test-8 /tmp/render-test-update /tmp/render-test-update-preserved /tmp/render-test-template /tmp/render-test-invalid /tmp/render-test-home /tmp/render-test-empty-home /tmp/render-test-user-compose.yml

    # Invalid identifiers must fail before any project files or tasks execute.
    if uv tool run --from copier==9.17.1 copier copy --defaults \
      --data project_name="Invalid" \
      --data project_slug="Invalid Slug" \
      . /tmp/render-test-invalid >/dev/null 2>&1; then
        echo "FAIL: invalid project_slug passed Copier validation"
        exit 1
    fi

    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test1" \
      --data coding_agents='["claude_code"]' \
      --data claude_provider=subscription \
      --data include_sandbox=false \
      . /tmp/render-test-1

    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test2" \
      --data coding_agents='["claude_code","codex","opencode","aider"]' \
      --data include_sandbox=true \
      --data sandbox_auto_init=true \
      --data sandbox_observability=langfuse \
      --data include_crawl4ai=true \
      . /tmp/render-test-2

    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test3" \
      --data coding_agents='["claude_code","opencode"]' \
      --data include_sandbox=true \
      --data sandbox_auto_init=true \
      --data sandbox_observability=mlflow \
      . /tmp/render-test-3

    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test4" \
      --data coding_agents='["claude_code","codex","pi","opencode","aider"]' \
      --data include_context7=true \
      --data python_version="3.14" \
      --data include_sandbox=false \
      . /tmp/render-test-4

    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test5" \
      --data coding_agents='["codex","opencode"]' \
      --data codex_provider=litellm \
      --data ollama_subscription=true \
      --data ollama_tier=hybrid \
      --data include_context7=false \
      --data python_version="3.12" \
      --data include_sandbox=false \
      . /tmp/render-test-5

    # Test 6: GitLab CI — .gitlab-ci.yml present, .github/workflows absent.
    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test6" \
      --data project_description='A "quoted" project.' \
      --data author_name="O'Reilly" \
      --data coding_agents='["claude_code"]' \
      --data claude_provider=subscription \
      --data include_sandbox=false \
      --data cicd_provider=gitlab_ci \
      . /tmp/render-test-6

    # Test 7: No CI/CD — neither provider generates files.
    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test7" \
      --data coding_agents='["claude_code"]' \
      --data claude_provider=subscription \
      --data include_sandbox=false \
      --data cicd_provider=none \
      . /tmp/render-test-7

    # Test 8: Claude + Codex + Pi share one multi-install-safe Spec-Kit project.
    uv tool run --from copier==9.17.1 copier copy --trust --defaults --vcs-ref=HEAD \
      --data project_name="Test8" \
      --data coding_agents='["claude_code","codex","pi"]' \
      --data claude_provider=subscription \
      --data codex_provider=subscription \
      --data include_sandbox=false \
      --data sdd_framework=spec-kit \
      --data sdd_install_agent=claude \
      . /tmp/render-test-8

    # Update regression: start from the previous committed template, add
    # project-owned content, then update to the dirty working tree under test.
    # The authored content must be untouched, deleted starter files must stay
    # deleted, template-owned config must still update, and copy-only tasks must
    # not create the sandbox .env during `copier update --trust`.
    git clone -q "$PWD" /tmp/render-test-template
    git diff --binary HEAD | git -C /tmp/render-test-template apply -
    git -C /tmp/render-test-template add -A
    git -C /tmp/render-test-template \
      -c user.name=RenderTest -c user.email=render-test@example.com \
      commit --allow-empty -qm 'template under test'
    uv tool run --from copier==9.17.1 copier copy --trust --defaults --skip-tasks \
      --vcs-ref=98d5d41 \
      --data project_name="UpdateTest" \
      --data python_version="3.12" \
      --data include_sandbox=true \
      --data sandbox_auto_init=true \
      /tmp/render-test-template /tmp/render-test-update
    printf '\nProject-owned changelog entry.\n' >> /tmp/render-test-update/CHANGELOG.md
    printf '\nProject-owned README section.\n' >> /tmp/render-test-update/README.md
    printf '\nProject-owned documentation.\n' >> /tmp/render-test-update/docs/index.md
    printf '\n# Project-owned source edit.\n' >> /tmp/render-test-update/src/updatetest/__init__.py
    rm /tmp/render-test-update/src/updatetest/example.py \
      /tmp/render-test-update/tests/test_smoke.py
    mkdir -p /tmp/render-test-update-preserved/src/updatetest \
      /tmp/render-test-update-preserved/docs
    cp /tmp/render-test-update/CHANGELOG.md \
      /tmp/render-test-update-preserved/CHANGELOG.md
    cp /tmp/render-test-update/README.md \
      /tmp/render-test-update-preserved/README.md
    cp /tmp/render-test-update/docs/index.md \
      /tmp/render-test-update-preserved/docs/index.md
    cp /tmp/render-test-update/src/updatetest/__init__.py \
      /tmp/render-test-update-preserved/src/updatetest/__init__.py
    (cd /tmp/render-test-update \
      && git init -q -b main \
      && git add -A \
      && git -c user.name=RenderTest -c user.email=render-test@example.com \
        commit -qm 'project-owned content' \
      && uv tool run --from copier==9.17.1 copier update --trust --defaults \
        --skip-answered --skip-tasks --vcs-ref=HEAD \
        --data python_version="3.14")
    cmp /tmp/render-test-update/CHANGELOG.md \
      /tmp/render-test-update-preserved/CHANGELOG.md
    cmp /tmp/render-test-update/README.md \
      /tmp/render-test-update-preserved/README.md
    cmp /tmp/render-test-update/docs/index.md \
      /tmp/render-test-update-preserved/docs/index.md
    cmp /tmp/render-test-update/src/updatetest/__init__.py \
      /tmp/render-test-update-preserved/src/updatetest/__init__.py
    test ! -e /tmp/render-test-update/src/updatetest/example.py
    test ! -e /tmp/render-test-update/tests/test_smoke.py
    test "$(cat /tmp/render-test-update/.python-version)" = "3.14"
    test ! -e /tmp/render-test-update/.env
    # Once the project is on the new task definitions, even a direct trusted
    # update without --skip-tasks must remain side-effect-free.
    (cd /tmp/render-test-update \
      && git add -A \
      && git -c user.name=RenderTest -c user.email=render-test@example.com \
        commit -qm 'apply template update' \
      && uv tool run --from copier==9.17.1 copier update --trust --defaults \
        --skip-answered --vcs-ref=HEAD)
    test ! -e /tmp/render-test-update/.env

    python3 -m json.tool /tmp/render-test-1/.claude/settings.json >/dev/null
    bash -n /tmp/render-test-1/.claude/scripts/statusline.sh
    rg -q 'ccusage@20\.0\.19' /tmp/render-test-1/.claude/scripts/statusline.sh
    ! rg -q '\{\{ tool_versions\.' /tmp/render-test-1/.claude/scripts/statusline.sh
    python3 -m json.tool /tmp/render-test-2/.claude/settings.json >/dev/null
    python3 -m json.tool /tmp/render-test-2/opencode.json >/dev/null
    python3 -c "import tomllib; tomllib.load(open('/tmp/render-test-2/.codex/config.toml','rb'))"
    python3 -m json.tool /tmp/render-test-3/.claude/settings.json >/dev/null
    python3 -m json.tool /tmp/render-test-3/opencode.json >/dev/null
    python3 -m json.tool /tmp/render-test-4/.claude/settings.json >/dev/null
    python3 -m json.tool /tmp/render-test-4/opencode.json >/dev/null
    python3 -m json.tool /tmp/render-test-5/opencode.json >/dev/null

    # Codex config.toml is TOML — validate via python tomllib.
    python3 -c "import tomllib; tomllib.load(open('/tmp/render-test-4/.codex/config.toml','rb'))"
    python3 -c "import tomllib; tomllib.load(open('/tmp/render-test-5/.codex/config.toml','rb'))"
    python3 -c "import tomllib; d=tomllib.load(open('/tmp/render-test-4/.codex/config.toml','rb')); assert d['model']=='gpt-5.6'; assert d['default_permissions']==':workspace'; assert 'sandbox_mode' not in d"
    python3 -c "import glob,tomllib; files=glob.glob('/tmp/render-test-4/.codex/agents/*.toml'); assert len(files)==3; [({'name','description','developer_instructions'} <= tomllib.load(open(path,'rb')).keys()) or (_ for _ in ()).throw(AssertionError(path)) for path in files]"
    python3 -c "import tomllib; d=tomllib.load(open('/tmp/render-test-5/.codex/litellm.config.toml.example','rb')); assert d['model_provider']=='litellm'; assert d['model_providers']['litellm']['base_url']"
    bash -n /tmp/render-test-4/.codex/hooks/verify-on-stop.sh
    test -L /tmp/render-test-4/.agents/skills
    test "$(readlink /tmp/render-test-4/.agents/skills)" = "../skills"

    # Aider YAML validate (uv tool run avoids host-Python missing yaml).
    uv tool run --from pyyaml==6.0.3 python3 -c "import yaml; yaml.safe_load(open('/tmp/render-test-4/.aider.conf.yml'))"

    # cd in den Render-Pfad, damit die von `sandbox-init` generierte
    # .env automatisch aufgegriffen wird und die :?-Guards greifen.
    (cd /tmp/render-test-2 \
        && docker compose --profile dev --profile trace config) >/dev/null
    (cd /tmp/render-test-3 \
        && docker compose --profile dev --profile trace config) >/dev/null

    # Global user instructions are opt-in, source-selective, read-only, and
    # local-only. Codex's override file must win over its regular AGENTS.md.
    mkdir -p /tmp/render-test-home/.claude/rules /tmp/render-test-home/.codex
    touch /tmp/render-test-home/.claude/CLAUDE.md \
      /tmp/render-test-home/.claude/rules/preferences.md \
      /tmp/render-test-home/.codex/AGENTS.md \
      /tmp/render-test-home/.codex/AGENTS.override.md
    (cd /tmp/render-test-2 \
        && printf 'yes\n' | HOME=/tmp/render-test-home just sandbox-enable-user-instructions)
    test -f /tmp/render-test-2/docker-compose.override.yml
    rg -q '^docker-compose\.override\.yml$' /tmp/render-test-2/.gitignore
    rg -q '\$\{HOME\}/\.claude/CLAUDE\.md' /tmp/render-test-2/docker-compose.override.yml
    rg -q '\$\{HOME\}/\.claude/rules' /tmp/render-test-2/docker-compose.override.yml
    rg -q '\$\{HOME\}/\.codex/AGENTS\.override\.md' /tmp/render-test-2/docker-compose.override.yml
    ! rg -q '\$\{HOME\}/\.codex/AGENTS\.md' /tmp/render-test-2/docker-compose.override.yml
    ! rg -q 'source:.*\.(claude|codex)["/]?$' /tmp/render-test-2/docker-compose.override.yml
    (cd /tmp/render-test-2 \
        && DOCKER_CONFIG="$HOME/.docker" HOME=/tmp/render-test-home \
          docker compose --profile dev --profile trace config) \
      > /tmp/render-test-user-compose.yml
    uv tool run --from pyyaml==6.0.3 python3 -c "import yaml; d=yaml.safe_load(open('/tmp/render-test-user-compose.yml')); v={x['target']: x for x in d['services']['agent']['volumes']}; expected={'/home/agent/.claude/CLAUDE.md','/home/agent/.claude/rules','/home/agent/.codex/AGENTS.override.md','/workspace/docker-compose.override.yml'}; assert expected <= v.keys(); assert all(v[t].get('read_only') is True for t in expected); assert '/home/agent/.codex/AGENTS.md' not in v"
    (cd /tmp/render-test-2 \
        && HOME=/tmp/render-test-home just sandbox-enable-user-instructions) >/dev/null

    rm /tmp/render-test-2/docker-compose.override.yml
    if (cd /tmp/render-test-2 \
        && printf 'no\n' | HOME=/tmp/render-test-home \
          just sandbox-enable-user-instructions) >/dev/null 2>&1; then
        echo "FAIL: user-instruction helper accepted an explicit rejection"
        exit 1
    fi
    test ! -e /tmp/render-test-2/docker-compose.override.yml
    printf '%s\n' 'services: {} # unmanaged sentinel' \
      > /tmp/render-test-2/docker-compose.override.yml
    if (cd /tmp/render-test-2 \
        && HOME=/tmp/render-test-home just sandbox-enable-user-instructions) \
      >/dev/null 2>&1; then
        echo "FAIL: user-instruction helper overwrote an unmanaged override"
        exit 1
    fi
    rg -Fxq 'services: {} # unmanaged sentinel' \
      /tmp/render-test-2/docker-compose.override.yml

    mkdir -p /tmp/render-test-empty-home
    if (cd /tmp/render-test-3 \
        && HOME=/tmp/render-test-empty-home just sandbox-enable-user-instructions) >/dev/null 2>&1; then
        echo "FAIL: user-instruction helper succeeded without supported sources"
        exit 1
    fi
    test ! -e /tmp/render-test-3/docker-compose.override.yml

    # Test 6: GitLab CI file present + valid, GitHub Actions absent.
    python3 -m json.tool /tmp/render-test-6/.claude/settings.json >/dev/null
    python3 -c "import tomllib; d=tomllib.load(open('/tmp/render-test-6/pyproject.toml','rb')); assert d['project']['description']=='A \"quoted\" project.'; assert d['project']['authors'][0]['name']==\"O'Reilly\""
    uv tool run --from pyyaml==6.0.3 python3 -c "import yaml; d=yaml.safe_load(open('/tmp/render-test-6/mkdocs.yml')); assert d['site_description']=='A \"quoted\" project.'"
    test -f /tmp/render-test-6/.gitlab-ci.yml \
        || { echo "FAIL: .gitlab-ci.yml missing in render-test-6"; exit 1; }
    test ! -f /tmp/render-test-6/.github/workflows/ci.yml \
        || { echo "FAIL: ci.yml must not exist in render-test-6"; exit 1; }
    uv tool run --from pyyaml==6.0.3 python3 -c "import yaml; d=yaml.safe_load(open('/tmp/render-test-6/.gitlab-ci.yml')); assert d.get('stages')==['qa','docs'], d.get('stages'); assert d['qa']['script']==['just qa']; assert d['docs']['script']==['just docs-build']"
    ! rg -q "docker build|docker push|kubectl" /tmp/render-test-6/.gitlab-ci.yml

    # Test 7: no CI files at all.
    python3 -m json.tool /tmp/render-test-7/.claude/settings.json >/dev/null
    test ! -f /tmp/render-test-7/.gitlab-ci.yml \
        || { echo "FAIL: .gitlab-ci.yml must not exist in render-test-7"; exit 1; }
    test ! -f /tmp/render-test-7/.github/workflows/ci.yml \
        || { echo "FAIL: ci.yml must not exist in render-test-7"; exit 1; }
    test ! -f /tmp/render-test-7/.github/dependabot.yml \
        || { echo "FAIL: dependabot.yml must not exist in render-test-7"; exit 1; }

    # Test 8: all selected safe integrations share the Spec-Kit project.
    test -L /tmp/render-test-8/.agents/skills
    test -f /tmp/render-test-8/docs/how-to/spec-driven-development.md
    test -f /tmp/render-test-8/.claude/skills/speckit-constitution/SKILL.md
    test -f /tmp/render-test-8/.agents/skills/speckit-constitution/SKILL.md
    test -f /tmp/render-test-8/.pi/prompts/speckit.constitution.md
    test -f /tmp/render-test-8/.specify/integration.json
    python3 -c "import json; d=json.load(open('/tmp/render-test-8/.specify/integration.json')); assert d['default_integration']=='claude'; assert set(d['installed_integrations'])=={'claude','codex','pi'}"
    (cd /tmp/render-test-8 && specify integration status --json) \
      | python3 -c "import json,sys; d=json.load(sys.stdin); assert d['status']=='ok'; assert d['multi_install_safe'] is True"
    rg -q "Spec-Kit" /tmp/render-test-8/docs/how-to/spec-driven-development.md
    ! rg -qi "openspec|open spec" /tmp/render-test-8

    # Regression: default-provider scenarios still get GitHub Actions.
    test -f /tmp/render-test-1/.github/workflows/ci.yml \
        || { echo "FAIL: ci.yml missing in render-test-1 (github_actions default regression)"; exit 1; }
    test -f /tmp/render-test-1/.github/dependabot.yml \
        || { echo "FAIL: dependabot.yml missing in render-test-1"; exit 1; }

    # Real generated-project gate. Staging is essential because pre-commit's
    # --all-files only examines files known to Git; without it a fresh render
    # reports "no files to check" and produces a false-positive result.
    (cd /tmp/render-test-6 \
        && git add -A \
        && just qa \
        && just docs-build)

    echo "render-test passed"
